# ── Local Docker development defaults ────────────────────────────────────────
# Replace every secret before staging or production. Never commit a real .env.

# ── Branding (used across metadata, footer, legal pages, MFA issuer) ─────────
BRAND_NAME="Black Forest"
NEXT_PUBLIC_BRAND_NAME="Black Forest Digital"
COMPANY_LEGAL_NAME="Black Forest Digital LTD"
SUPPORT_EMAIL="support@blackforrestt.com"
BRAND_DOMAIN="blackforrestt.com"
# Mirror/alias apex domains serving the SAME files (comma-separated). The
# FIRST entry of BRAND_DOMAINS (or BRAND_DOMAIN when this is unset) stays
# canonical — emails, referral links, sitemap, SEO, and login redirects to
# trade.<canonical> all use it. Mirror domains serve marketing content;
# authenticated routes on them redirect to the canonical trade subdomain.
# Also append each mirror origin to APP_ORIGIN, and set DOMAIN_2 in the
# production .env so Caddy provisions its certificate.
# BRAND_DOMAINS="blackforrestt.com,agilefgs.com"
# Per-domain brand overrides (JSON, keyed by apex domain). A domain without an
# entry inherits the primary brand. "tradeEnabled": true routes that domain's
# app traffic to trade.<domain> — only after its DNS + TLS exist (TRADE_DOMAIN_2
# in the production env / Caddy block).
# BRAND_OVERRIDES='{"agilefgs.com":{"name":"Agile FGS","shortName":"Agile FGS","legalName":"Agile FGS Ltd","supportEmail":"support@agilefgs.com","address":"…","trademark":"Agile FGS™","wordmark":["Agile","FGS"],"tradeEnabled":true,"emailFrom":"no-reply@agilefgs.com","emailColor":"#0ea5e9","ogImage":"/brands/agilefgs/og.png","accentColor":"#0ea5e9","glyph":{"viewBox":"0 0 24 24","paths":[{"d":"M4 4h16v4H4z"},{"d":"M4 10h10v4H4z"}]}}}'
# Override fields: name/shortName/legalName/supportEmail/address/trademark/
# wordmark (logo text pair), tradeEnabled (own trade subdomain — needs DNS +
# TLS), emailFrom/emailReplyTo/emailColor/emailLogoUrl (transactional email
# identity), ogImage (share image under /public), accentColor + glyph
# (generated favicon and logo mark). Signups store their domain on the user
# row; later emails render under that brand automatically.
COMPANY_ADDRESS="13 Ramsgate Street, London, England, E8 2FD"
BRAND_TM="Black Forest™"

# ── Company registration & regulatory identity ───────────────────────────────
# PLACEHOLDERS — replace with the company's real details before going live.
# When left empty the footer shows generic assurance badges only and the
# JSON-LD Organization schema omits the identifiers. Do NOT invent values.
# Company registry incorporation number (e.g. "12345678")
COMPANY_REGISTRATION_NUMBER=""
# Jurisdiction of incorporation (e.g. "England & Wales" / "Republic of Seychelles")
COMPANY_JURISDICTION=""
# Licensing/regulatory authority name (e.g. "Financial Conduct Authority")
COMPANY_REGULATOR=""
# License number issued by the regulator
COMPANY_LICENSE_NUMBER=""
# Investor compensation scheme the firm belongs to (e.g. "FSCS")
INVESTOR_COMPENSATION_SCHEME=""

POSTGRES_PASSWORD="blckforest"
DATABASE_URL="postgresql://blckforest:blckforest@localhost:5432/blckforest?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-with-openssl-rand-hex-32"
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="change-me-with-openssl-rand-base64-32"
# Generate with: openssl rand -hex 32
SECURITY_HASH_PEPPER="change-me-with-openssl-rand-hex-32"
# Comma-separated allowlist of public origins. Include every domain the
# platform answers on, including mirrors, so browser POSTs pass the
# cross-origin gate — e.g.
# "https://blackforrestt.com,https://trade.blackforrestt.com,https://blackforest.com"
APP_ORIGIN="http://localhost:3000"
# Auth.js canonical origin. Keep this identical to the first APP_ORIGIN value.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="false"
DEV_EMAIL_PREVIEW="true"
ALLOW_UNVERIFIED_WITHDRAWALS="true"

# New accounts are created unfunded. Email verification is required.
REGISTRATION_REQUIRE_EMAIL_VERIFICATION="false"

# Transactional email. Use `disabled` with DEV_EMAIL_PREVIEW=true locally,
# `resend` for the built-in Resend HTTPS adapter, or `http` for a private adapter.
# Master kill-switch for ALL outbound email. Set to "false" to stop every
# delivery path (outbox queue, immediate sends, verification & password-reset
# security emails). Queued emails are recorded as SKIPPED instead of sent.
EMAIL_DELIVERY_ENABLED="false"
EMAIL_PROVIDER="disabled"
RESEND_API_KEY=""
EMAIL_API_URL=""
EMAIL_API_TOKEN=""
EMAIL_FROM="Black Forest <notifications@blackforrestt.com>"
EMAIL_REPLY_TO="support@blackforrestt.com"
EMAIL_SUPPORT_ADDRESS="support@blackforrestt.com"
EMAIL_BRAND_NAME="Black Forest"
EMAIL_BRAND_COLOR="#16a34a"
EMAIL_LOGO_URL=""
EMAIL_DISPATCH_INTERVAL_MS="15000"
EMAIL_MAX_ATTEMPTS="5"
# Reclaim outbox jobs left PROCESSING after an interrupted process.
EMAIL_PROCESSING_TIMEOUT_MS="120000"

# ── Private S3-compatible KYC/payment document storage (MinIO locally) ───────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_PREFIX="blckforest-kyc"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
# Production may set a customer-managed key. Local MinIO uses bucket SSE-S3.
KYC_KMS_KEY_ID=""
KYC_DOWNLOAD_TTL_SECONDS="300"
KYC_MAX_BYTES="10485760"
KYC_RETENTION_DAYS="2555"
NEXT_PUBLIC_KYC_MAX_BYTES="10485760"
KYC_SCANNER="stub"
# Only permits the stub in the loopback complete-Docker demo; never enable on a public origin.
ALLOW_LOCAL_STUB_SCANNER="true"
# Production: set KYC_SCANNER=http and point this at an approved scanner gateway.
MALWARE_SCANNER_URL=""
MALWARE_SCANNER_TOKEN=""
MALWARE_SCANNER_TIMEOUT_MS="30000"
PAYMENT_PROOF_MAX_BYTES="1048576"

# ── Payment risk controls ─────────────────────────────────────────────────────
PAYMENT_BENEFICIARY_COOLING_OFF_HOURS="24"
PAYMENT_PASSWORD_CHANGE_COOLING_OFF_HOURS="24"
PAYMENT_DAILY_WITHDRAWAL_LIMIT="25000"
PAYMENT_DAILY_WITHDRAWAL_COUNT="5"
PAYMENT_REQUIRE_DUAL_FINANCE_REVIEW="true"
# When true, a single finance reviewer can approve a PENDING payment directly (skips the separate Prepare step).
SIMPLE_PAYMENT_APPROVAL="false"
DEPOSIT_UI_ENABLED="true"
# Comma-separated payment methods to disable for BOTH deposit and withdrawal. Empty = all enabled. Values: CARD, BANK_TRANSFER, CRYPTO.
PAYMENT_METHODS_DISABLED=""
# Global default crypto deposit wallets shown to users (asset:network:address, semicolon-separated).
# Admins can override per-group or per-user in the admin console. Leave empty for none.
# Example: "USDT:TRON (TRC20):TXyZ...abc; BTC:Bitcoin:bc1q...xyz"
DEPOSIT_WALLET_ADDRESSES="BTC:Bitcoin:bc1q...xyz; USDT:BNB (BEP20):0xAbC...456; USDT:ETH (ERC20):0xAbC...789; ETH:Ethereum:0xAbC...123; USDT:TRON (TRC20):TXyZ...abc"

# ── Replay-safe reconciliation scheduler ─────────────────────────────────────
# Keep false for ordinary local UI development; production should set true.
RECONCILIATION_ENABLED="false"
RECONCILIATION_INTERVAL_MS="300000"
RECONCILIATION_LOCK_LEASE_MS="60000"
RECONCILIATION_RUN_STALE_MS="900000"
RECONCILIATION_PAYMENT_PENDING_HOURS="72"

# ── Application and simulated market engine ──────────────────────────────────
PORT="3000"
MARKET_TICK_MS="1000"
POSITION_PERSIST_EVERY_TICKS="5"
MAX_POSITION_LOTS="100"
MARKET_SEED="black-forest-dev"
MARKET_DATA_MODE="simulation"
FINNHUB_API_KEY=""
# auto = probe once then fall back; disabled = no REST history; required = fail on denial.
FINNHUB_CANDLE_MODE="auto"
FINNHUB_CANDLE_DELAY_MS="250"
# Alpha Vantage (alternative market-data provider). Set MARKET_DATA_MODE="alphavantage" and provide a key.
ALPHAVANTAGE_API_KEY=""
# Additional REST-polling providers. Set MARKET_DATA_MODE to "tickerlayer", "sifting", or "lse" and provide the matching key.
TICKERLAYER_API_KEY=""
SIFTING_API_KEY=""
LSE_API_KEY=""
# Economic calendar source. "forexfactory" = free (rate-limited); "finnhub" = Finnhub /calendar/economic (requires the Economic-1 paid add-on).
ECONOMIC_CALENDAR_SOURCE="forexfactory"
NEXT_PUBLIC_WS_URL=""
# Disconnect slow WebSocket consumers before their outbound queue exhausts memory.
WS_MAX_BUFFERED_BYTES="1048576"
