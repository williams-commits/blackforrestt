{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "npm run test:domains && npm run test:engine && npm run test:ws-protocol && npm run test:auth-client && npm run test:enterprise-ui-admin && npm run test:payment-methods && npm run test:email-templates",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "platform": "node --env-file-if-exists=.env --import tsx scripts/platform.mjs",
    "test:engine": "node --env-file-if-exists=.env --import tsx --test tests/positionEngine.test.ts",
    "test:ws-protocol": "node --env-file-if-exists=.env --import tsx --test tests/wsProtocol.test.ts",
    "test:auth-client": "node --env-file-if-exists=.env --import tsx --test tests/authClient.test.ts",
    "test:enterprise-ui-admin": "node --env-file-if-exists=.env --import tsx --test tests/enterprisePhase67.test.ts",
    "test:payment-methods": "node --env-file-if-exists=.env --import tsx --test tests/paymentMethodDetails.test.ts",
    "test:email-templates": "node --env-file-if-exists=.env --import tsx --test tests/emailTemplates.test.ts",
    "test:domains": "node --env-file-if-exists=.env --import tsx --test tests/domains.test.ts tests/registry-freshness.test.ts tests/platform-deploy.test.ts && node --env-file-if-exists=.env --import tsx --test tests/domain-cli.test.ts",
    "test:integration": "npm run test:accounting && npm run test:security && npm run test:kyc && npm run test:payments && npm run test:reconciliation && npm run test:admin && npm run test:admin-balance && npm run test:messaging && npm run test:multibrand",
    "test:accounting": "node --env-file-if-exists=.env --import tsx --test tests/accounting.integration.test.ts",
    "test:security": "node --env-file-if-exists=.env --import tsx --test tests/security.integration.test.ts",
    "test:kyc": "node --env-file-if-exists=.env --import tsx --test tests/kyc.storage.integration.test.ts",
    "test:payments": "node --env-file-if-exists=.env --import tsx --test tests/payments.integration.test.ts",
    "test:reconciliation": "node --env-file-if-exists=.env --import tsx --test tests/reconciliation.integration.test.ts",
    "test:admin": "node --env-file-if-exists=.env --import tsx --test tests/admin.integration.test.ts",
    "test:admin-balance": "node --env-file-if-exists=.env --import tsx --test tests/adminBalance.integration.test.ts",
    "test:messaging": "node --env-file-if-exists=.env --import tsx --test tests/messaging.integration.test.ts",
    "test:multibrand": "node --env-file-if-exists=.env --import tsx --test tests/multibrand.integration.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@prisma/client": "^6.2.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "bcryptjs": "^3.0.3",
    "lightweight-charts": "^5.0.3",
    "lucide-react": "^1.34.0",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.5",
    "prisma": "^6.2.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.1.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "15.5.23"
  }
}