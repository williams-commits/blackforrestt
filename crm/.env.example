# ── CRM module environment (local development) ────────────────────────────
# The CRM uses its own database on the platform's PostgreSQL container.
# Create it once with:
#   docker compose exec postgres psql -U postgres -c 'CREATE DATABASE blckforest_crm;'
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blckforest_crm?schema=public"

# Auth.js — MUST be a distinct secret from the trading platform's.
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3100"
# Dev convenience only; production behind Caddy must set this to "false"
# once the forwarded-host headers are verified.
AUTH_TRUST_HOST="true"

# Trading-platform bridge (read-only internal API on the platform app)
PLATFORM_BRIDGE_URL="http://localhost:3000"
PLATFORM_BRIDGE_TOKEN=""
