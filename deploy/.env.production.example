# Copy to .env.production in the repository root. chmod 600 .env.production.
# Every "replace-*" value must be generated with openssl or set to a real secret.
NODE_ENV=production

# ── Domain / reverse proxy ──────────────────────────────────────────────────
DOMAIN=blackforrestt.com
# Optional: authenticated application subdomain (e.g. trade.blackforrestt.com).
# When empty, the platform runs in single-domain mode (backward compatible).
TRADE_DOMAIN=trade.blackforrestt.com
# Subdomain prefix used by the app to build trade URLs. Default: trade.
TRADE_SUBDOMAIN=trade
CADDY_EMAIL=ops@blackforrestt.com
APP_IMAGE=blackforrestt-app:latest
# Baked into client bundles at build time. Marketing CTAs (Login/Register)
# use this to link to the authenticated subdomain. Empty = single-domain mode.
NEXT_PUBLIC_TRADE_ORIGIN=https://trade.blackforrestt.com

# ── Branding ────────────────────────────────────────────────────────────────
BRAND_NAME="Black Forest"
NEXT_PUBLIC_BRAND_NAME="Black Forest Digital"
COMPANY_LEGAL_NAME="Black Forest Digital LTD"
SUPPORT_EMAIL=support@blackforrestt.com
BRAND_DOMAIN=blackforrestt.com
BRAND_TM="Black Forest™"
COMPANY_ADDRESS="13 Ramsgate Street, London, England, E8 2FD"

# ── Company registration & regulatory identity ───────────────────────────────
# PLACEHOLDERS — set the company's real registration/licence details before
# launch. Empty values keep the footer generic and omit identifiers from the
# Organization JSON-LD. Never publish invented regulatory claims.
COMPANY_REGISTRATION_NUMBER=
COMPANY_JURISDICTION=
COMPANY_REGULATOR=
COMPANY_LICENSE_NUMBER=
INVESTOR_COMPENSATION_SCHEME=

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=blackforrestt
POSTGRES_DB=blackforrestt
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
# Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://blackforrestt:replace-with-openssl-rand-hex-24@postgres:5432/blackforrestt?schema=public
REDIS_URL=redis://redis:6379

# ── Auth / security ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Generate with: openssl rand -hex 32
SECURITY_HASH_PEPPER=replace-with-openssl-rand-hex-32
# Comma-separated: both origins must be listed so the same-origin gate
# accepts requests arriving on either domain.
APP_ORIGIN=https://blackforrestt.com,https://trade.blackforrestt.com
# Canonical Auth.js URL = the trade subdomain (where login happens).
AUTH_URL=https://trade.blackforrestt.com
AUTH_TRUST_HOST=true
DEV_EMAIL_PREVIEW=false
ALLOW_UNVERIFIED_WITHDRAWALS=false
# Email verification required for new registrations. true = required (recommended).
REGISTRATION_REQUIRE_EMAIL_VERIFICATION=false

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=resend_api_key_goes_here
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM="Black Forest <intake@reclaimprolaw.org>"
EMAIL_REPLY_TO=intake@reclaimprolaw.org
EMAIL_SUPPORT_ADDRESS=intake@reclaimprolaw.org
EMAIL_BRAND_NAME="Black Forest"
EMAIL_BRAND_COLOR="#fd7e14"
EMAIL_LOGO_URL=
EMAIL_DISPATCH_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5
EMAIL_PROCESSING_TIMEOUT_MS=120000

# ── Storage / KYC ───────────────────────────────────────────────────────────
# IMPORTANT: with the bundled MinIO, the app authenticates using the SAME root
# credentials, so S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY must equal
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD. Generate one strong pair and use it in
# both places. Never use the upstream "minioadmin/minioadmin" default in prod.
#   user:     pick a non-default name (e.g. openssl rand -hex 8)
#   password: openssl rand -hex 24
MINIO_ROOT_USER=replace-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_PREFIX=blackforrestt-kyc
S3_ACCESS_KEY_ID=replace-minio-root-user
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24
S3_FORCE_PATH_STYLE=true
KYC_KMS_KEY_ID=
KYC_MAX_BYTES=10485760
KYC_RETENTION_DAYS=2555
NEXT_PUBLIC_KYC_MAX_BYTES=10485760
KYC_SCANNER=http
ALLOW_LOCAL_STUB_SCANNER=false
# The stack ships a ClamAV + gateway pair (clamav / malware-scanner services).
# Leave this default unless you point at an external scanning service instead.
# First boot downloads virus signatures (~2-3 min); scans fail closed (503)
# until clamd is up. Optional shared secret; must match on both sides.
MALWARE_SCANNER_URL=http://malware-scanner:8080/scan
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=30000
PAYMENT_PROOF_MAX_BYTES=1048576

# ── Payments ────────────────────────────────────────────────────────────────
PAYMENT_BENEFICIARY_COOLING_OFF_HOURS=0
PAYMENT_PASSWORD_CHANGE_COOLING_OFF_HOURS=0
PAYMENT_DAILY_WITHDRAWAL_LIMIT=500
PAYMENT_DAILY_WITHDRAWAL_COUNT=1
PAYMENT_REQUIRE_DUAL_FINANCE_REVIEW=false
SIMPLE_PAYMENT_APPROVAL=true
DEPOSIT_UI_ENABLED=false
# Comma-separated payment methods to disable for BOTH deposit and withdrawal. Empty = all enabled. Values: CARD, BANK_TRANSFER, CRYPTO.
PAYMENT_METHODS_DISABLED="CARD, BANK_TRANSFER"
# Global default crypto deposit wallets shown to users (asset:network:address, semicolon-separated).
# Admins can override per-group or per-user in the admin console. Leave empty for none.
# Example: "USDT:TRON (TRC20):TXyZ...abc; BTC:Bitcoin:bc1q...xyz"
DEPOSIT_WALLET_ADDRESSES=""

# ── Reconciliation ──────────────────────────────────────────────────────────
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_LOCK_LEASE_MS=60000
RECONCILIATION_RUN_STALE_MS=900000
RECONCILIATION_PAYMENT_PENDING_HOURS=0

# ── Market engine ───────────────────────────────────────────────────────────
PORT=3000
MARKET_TICK_MS=1000
POSITION_PERSIST_EVERY_TICKS=5
MAX_POSITION_LOTS=100
MARKET_SEED=black-forest-dev
# Values: simulation, finnhub, alphavantage, tickerlayer, sifting, lse
MARKET_DATA_MODE=finnhub
FINNHUB_API_KEY=replace-with-finnhub-key
FINNHUB_CANDLE_MODE=disabled
FINNHUB_CANDLE_DELAY_MS=1050
ALPHAVANTAGE_API_KEY=replace-with-alphavantage-key
TICKERLAYER_API_KEY=replace-with-tickerlayer-key
SIFTING_API_KEY=replace-with-sifting-key
LSE_API_KEY=replace-with-lse-key
NEXT_PUBLIC_WS_URL=
WS_MAX_BUFFERED_BYTES=1048576

# ── Economic calendar ───────────────────────────────────────────────────────
# "forexfactory" (default, free, rate-limited) or "finnhub" (requires Economic-1 paid add-on)
ECONOMIC_CALENDAR_SOURCE=forexfactory
