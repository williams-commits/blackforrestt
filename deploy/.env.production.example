# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT — copy to .env.production (repository root, chmod 600)
# ═══════════════════════════════════════════════════════════════════════════
# SETUP CHECKLIST (everything else is tuning):
#   1. Fill every "replace-*" secret — the openssl command is on each line.
#   2. Point DNS for every domain listed in section 1 at this server.
#   3. Deploy with deploy/deploy.sh, then run: docker compose -f
#      deploy/docker-compose.prod.yml exec app npx prisma migrate deploy
#
# Multi-brand lives ENTIRELY in section 1: domains, the brand list, and the
# per-domain override profiles. Sections 2–3 define the PRIMARY brand that
# every domain without an override inherits.
NODE_ENV=production

# ── 1. Domains & brand families ─────────────────────────────────────────────
# Brand 1 (primary/canonical): blackforrestt.com + trade.blackforrestt.com
DOMAIN=blackforrestt.com
# Primary authenticated app host (login, terminal, account, admin).
# Empty = single-domain mode (backward compatible).
TRADE_DOMAIN=trade.blackforrestt.com
# Subdomain label used to build trade URLs. Default: trade.
TRADE_SUBDOMAIN=trade
CADDY_EMAIL=ops@blackforrestt.com
APP_IMAGE=blackforrestt-app:latest

# Brand 2: Agile FGS — ACTIVE. DNS for both hosts must point here before
# deploying; Caddy provisions TLS automatically. Leave both empty to disable
# the family.
DOMAIN_2=agilefgs.com
TRADE_DOMAIN_2=trade.agilefgs.com

# Brand 3: pre-wired, empty slots.
# HOW TO ADD A BRAND (no code changes, no Caddyfile edits):
#   1. DNS: point <domain> (and trade.<domain>) at this server.
#   2. Set DOMAIN_3 / TRADE_DOMAIN_3 below.
#   3. Append the domain to BRAND_DOMAINS (below).
#   4. Append an entry to BRAND_OVERRIDES (template at the bottom of this
#      section) with its name, support email, address, wordmark, tradeEnabled.
#   5. Append its origins to APP_ORIGIN (section 6).
#   6. Redeploy. Favicon, PWA manifest, logo, footer/legal pages, login
#      routing, and per-user emails all follow automatically.
DOMAIN_3=
TRADE_DOMAIN_3=

# All apex domains served by this deployment, canonical first. The FIRST
# entry is canonical: SEO/sitemap, referral links, default trade-host
# redirects, and the primary email identity all use it.
BRAND_DOMAINS=blackforrestt.com,agilefgs.com

# Per-domain brand profiles (single-line JSON, keyed by apex domain). A domain
# without an entry inherits the primary brand (section 2). Invalid JSON safely
# falls back to primary branding everywhere.
#
# ACTIVE — Agile FGS. One line drives the whole brand: logo wordmark, UI
# name/support email/address/trademark, per-domain favicon + PWA manifest,
# brand-correct login routing (trade.agilefgs.com), and per-user transactional
# emails for everyone who signs up on agilefgs.com.
# Sending EMAIL as Agile FGS later: verify agilefgs.com at the email provider
# (SPF/DKIM), then add  "emailFrom":"Agile FGS <no-reply@agilefgs.com>"  to
# the entry below. Until then agilefgs users receive primary-branded sends.
BRAND_OVERRIDES={"agilefgs.com":{"name":"Agile FGS","shortName":"Agile FGS","legalName":"Agile FGS Ltd","supportEmail":"support@agilefgs.com","address":"Airedale House, 423 Kirkstall Road, Leeds, England, LS4 2EW","trademark":"Agile FGS™","wordmark":["Agile","FGS"],"tradeEnabled":true}}
#
# TEMPLATE for the next brand — copy, fill, and merge into BRAND_OVERRIDES as
# another "domain":{...} entry (comma-separated inside the same JSON object):
#   "brand3.com":{"name":"Brand Three","shortName":"Brand3","legalName":"Brand Three Ltd",
#     "supportEmail":"support@brand3.com","address":"…","trademark":"Brand3™",
#     "wordmark":["Brand","Three"],"tradeEnabled":true,
#     "accentColor":"#0ea5e9",                       // favicon/logo/QR accent (optional)
#     "glyph":{"viewBox":"0 0 24 24","paths":[{"d":"M…"}]},  // custom logo mark (optional)
#     "ogImage":"/brands/brand3/og.png",             // share image under public/ (optional)
#     "emailFrom":"Brand Three <no-reply@brand3.com>",        // after provider verification
#     "emailColor":"#0ea5e9","emailLogoUrl":"https://…"}      // email button/logo (optional)

# ── 2. Primary brand (inherited by every domain without an override) ────────
BRAND_NAME="Black Forest"
NEXT_PUBLIC_BRAND_NAME="Black Forest Digital"
COMPANY_LEGAL_NAME="Black Forest Digital LTD"
SUPPORT_EMAIL=support@blackforrestt.com
BRAND_DOMAIN=blackforrestt.com
BRAND_TM="Black Forest™"
COMPANY_ADDRESS="13 Ramsgate Street, London, England, E8 2FD"
# NOTE: NEXT_PUBLIC_TRADE_ORIGIN is no longer used — marketing CTAs link
# relatively and the middleware routes each brand family to its own trade host.

# ── 3. Company registration & regulatory identity (primary) ─────────────────
# Per-brand regulatory details go in that brand's BRAND_OVERRIDES entry
# (companyRegulator, companyLicenseNumber, …same field names as here).
# PLACEHOLDERS — set the real details before launch. Empty values keep the
# footer generic and omit identifiers from the Organization JSON-LD. Never
# publish invented regulatory claims.
COMPANY_REGISTRATION_NUMBER=
COMPANY_JURISDICTION=
COMPANY_REGULATOR=
COMPANY_LICENSE_NUMBER=
INVESTOR_COMPENSATION_SCHEME=

# ── 4. Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=blackforrestt
POSTGRES_DB=blackforrestt
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
# Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://blackforrestt:replace-with-openssl-rand-hex-24@postgres:5432/blackforrestt?schema=public
REDIS_URL=redis://redis:6379

# ── 5. Auth & request security ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Generate with: openssl rand -hex 32
SECURITY_HASH_PEPPER=replace-with-openssl-rand-hex-32
# Comma-separated: EVERY origin the platform answers on — each apex and each
# trade subdomain of every brand family — so the same-origin gate accepts
# requests arriving on it. Adding a brand? Append its two origins here.
APP_ORIGIN=https://blackforrestt.com,https://trade.blackforrestt.com,https://agilefgs.com,https://trade.agilefgs.com
# Auth.js canonical URL = the PRIMARY trade subdomain. With AUTH_TRUST_HOST=true
# (REQUIRED for multi-domain — keep it), Auth.js derives the real base URL per
# request from the Host / X-Forwarded-Host headers Caddy sets, so login works
# identically on every trade host of every brand family: callbacks, CSRF, and
# redirects stay same-origin on whichever host the user is on. AUTH_URL itself
# is only a fallback for requests without a host header. Session cookies are
# host-scoped — a login on trade.agilefgs.com is a separate session from
# trade.blackforrestt.com; brand families stay isolated by design.
AUTH_URL=https://trade.blackforrestt.com
AUTH_TRUST_HOST=true
DEV_EMAIL_PREVIEW=false
ALLOW_UNVERIFIED_WITHDRAWALS=false
# Email verification required for new registrations. true = required (recommended).
REGISTRATION_REQUIRE_EMAIL_VERIFICATION=false

# ── 6. Email ────────────────────────────────────────────────────────────────
# Primary email identity — also the fallback sender for brand families that
# don't set "emailFrom" in BRAND_OVERRIDES.
# Master kill-switch for ALL outbound email. Set to false to stop every
# delivery path (outbox queue, immediate sends, verification & password-reset
# security emails). Queued emails are recorded as SKIPPED instead of sent.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=resend_api_key_goes_here
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM="Black Forest <no-reply@blackforrestt.com>"
EMAIL_REPLY_TO=support@blackforrestt.com
EMAIL_SUPPORT_ADDRESS=support@blackforrestt.com
EMAIL_BRAND_NAME="Black Forest"
EMAIL_BRAND_COLOR="#fd7e14"
EMAIL_LOGO_URL=
EMAIL_DISPATCH_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5
EMAIL_PROCESSING_TIMEOUT_MS=120000

# ── 7. Storage / KYC ────────────────────────────────────────────────────────
# IMPORTANT: with the bundled MinIO, the app authenticates using the SAME root
# credentials, so S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY must equal
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD. Generate one strong pair and use it in
# both places. Never use the upstream "minioadmin/minioadmin" default in prod.
#   user:     pick a non-default name (e.g. openssl rand -hex 8)
#   password: openssl rand -hex 24
MINIO_ROOT_USER=replace-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_PREFIX=blackforrestt-kyc
S3_ACCESS_KEY_ID=replace-minio-root-user
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-24
S3_FORCE_PATH_STYLE=true
KYC_KMS_KEY_ID=
KYC_MAX_BYTES=10485760
KYC_RETENTION_DAYS=2555
NEXT_PUBLIC_KYC_MAX_BYTES=10485760
KYC_SCANNER=http
ALLOW_LOCAL_STUB_SCANNER=false
# The stack ships a ClamAV + gateway pair (clamav / malware-scanner services).
# Leave this default unless you point at an external scanning service instead.
# First boot downloads virus signatures (~2-3 min); scans fail closed (503)
# until clamd is up. Optional shared secret; must match on both sides.
MALWARE_SCANNER_URL=http://malware-scanner:8080/scan
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=30000
PAYMENT_PROOF_MAX_BYTES=1048576

# ── 8. Payments ─────────────────────────────────────────────────────────────
PAYMENT_BENEFICIARY_COOLING_OFF_HOURS=0
PAYMENT_PASSWORD_CHANGE_COOLING_OFF_HOURS=0
PAYMENT_DAILY_WITHDRAWAL_LIMIT=500
PAYMENT_DAILY_WITHDRAWAL_COUNT=1
PAYMENT_REQUIRE_DUAL_FINANCE_REVIEW=false
SIMPLE_PAYMENT_APPROVAL=true
DEPOSIT_UI_ENABLED=false
# Comma-separated payment methods to disable for BOTH deposit and withdrawal. Empty = all enabled. Values: CARD, BANK_TRANSFER, CRYPTO.
PAYMENT_METHODS_DISABLED="CARD, BANK_TRANSFER"
# Global default crypto deposit wallets shown to users (asset:network:address, semicolon-separated).
# Admins can override per-group or per-user in the admin console. Leave empty for none.
# Example: "USDT:TRON (TRC20):TXyZ...abc; BTC:Bitcoin:bc1q...xyz"
DEPOSIT_WALLET_ADDRESSES=""

# ── 9. Reconciliation ───────────────────────────────────────────────────────
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_LOCK_LEASE_MS=60000
RECONCILIATION_RUN_STALE_MS=900000
RECONCILIATION_PAYMENT_PENDING_HOURS=0

# ── 10. Market engine ───────────────────────────────────────────────────────
PORT=3000
MARKET_TICK_MS=1000
POSITION_PERSIST_EVERY_TICKS=5
MAX_POSITION_LOTS=100
MARKET_SEED=black-forest-dev
# Values: simulation, finnhub, alphavantage, tickerlayer, sifting, lse
MARKET_DATA_MODE=finnhub
FINNHUB_API_KEY=replace-with-finnhub-key
FINNHUB_CANDLE_MODE=disabled
FINNHUB_CANDLE_DELAY_MS=1050
ALPHAVANTAGE_API_KEY=replace-with-alphavantage-key
TICKERLAYER_API_KEY=replace-with-tickerlayer-key
SIFTING_API_KEY=replace-with-sifting-key
LSE_API_KEY=replace-with-lse-key
NEXT_PUBLIC_WS_URL=
WS_MAX_BUFFERED_BYTES=1048576

# ── 11. Economic calendar ───────────────────────────────────────────────────
# "forexfactory" (default, free, rate-limited) or "finnhub" (requires Economic-1 paid add-on)
ECONOMIC_CALENDAR_SOURCE=forexfactory
