{
  email {$CADDY_EMAIL}
  admin off
}

# Apex domain — marketing site + public market data.
# TRADE_DOMAIN is optional: when empty, the second block is skipped and the
# platform runs as a single domain (backward compatible).
{$DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}

# Trade subdomain — authenticated application (login, trade terminal, account,
# admin). Only evaluated when TRADE_DOMAIN is set (non-empty).
{$TRADE_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}
