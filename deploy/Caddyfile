{
  email {$CADDY_EMAIL}
  admin off
}

# Apex domain — marketing site + public market data.
# TRADE_DOMAIN is optional: when empty, the second block is skipped and the
# platform runs as a single domain (backward compatible).
{$DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}

# Trade subdomain — authenticated application (login, trade terminal, account,
# admin). Only evaluated when TRADE_DOMAIN is set (non-empty).
{$TRADE_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}

# Optional trade subdomain for the mirror domain (e.g. trade.agilefgs.com).
# Only needed when the mirror brand's BRAND_OVERRIDES entry sets
# "tradeEnabled": true — then its app traffic stays on its own domain.
{$TRADE_DOMAIN_2} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}

# Mirror/alias apex domain — serves the SAME files as {$DOMAIN} until it gets
# its own landing page. Caddy provisions its TLS certificate automatically;
# point the domain's DNS at this server first. Only evaluated when DOMAIN_2 is
# set (non-empty). Add BRAND_DOMAINS in the app env so the Next.js middleware
# recognizes the host, and append its origin to APP_ORIGIN.
{$DOMAIN_2} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}
