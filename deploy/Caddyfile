{
  email {$CADDY_EMAIL}
  admin off
}

{$DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}
