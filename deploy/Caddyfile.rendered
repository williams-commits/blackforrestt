# Generated by deploy/render-caddy.sh from .env.production.example — do not edit.
{
  email ops@blackforrestt.com
  admin off
}

# Shared site configuration — every domain block below imports this, so all
# brand families get identical proxying, security headers, health checks, and
# logging.
(app-site) {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 15s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}

# DOMAIN
blackforrestt.com {
  import app-site
}

# TRADE_DOMAIN
trade.blackforrestt.com {
  import app-site
}

# DOMAIN_2
agilefgs.com {
  import app-site
}

# TRADE_DOMAIN_2
trade.agilefgs.com {
  import app-site
}

