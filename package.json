{
  "name": "blckforest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "next build",
    "build:clean": "rm -rf .next .turbo node_modules/.cache && next build",
    "clean": "rm -rf .next",
    "clean:node-modules": "rm -rf node_modules",
    "clean:package-lock": "rm -rf package-lock.json",
    "clean:node-modules:package-lock": "npm run clean:node-modules && npm run clean:package-lock",
    "stop:server": "lsof -i :3000 | awk 'NR!=1 {print $2}' | xargs kill -9",
    "start": "NODE_ENV=production node --env-file-if-exists=.env scripts/production/preflight.mjs && NODE_ENV=production node --env-file-if-exists=.env --import tsx server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "auth:doctor": "node --env-file-if-exists=.env scripts/auth/doctor.mjs",
    "test:engine": "node --import tsx --test tests/positionEngine.test.ts",
    "test:accounting": "node --import tsx --test tests/accounting.integration.test.ts",
    "test:security": "node --import tsx --test tests/security.integration.test.ts",
    "test:kyc": "node --import tsx --test tests/kyc.storage.integration.test.ts",
    "test:payments": "node --import tsx --test tests/payments.integration.test.ts",
    "test:reconciliation": "node --import tsx --test tests/reconciliation.integration.test.ts",
    "test:integration": "npm run test:accounting && npm run test:security && npm run test:kyc && npm run test:payments && npm run test:reconciliation && npm run test:admin && npm run test:admin-balance",
    "test:unit": "npm run test:engine && npm run test:ws-protocol && npm run test:auth-client && npm run test:enterprise-ui-admin && npm run test:payment-methods && npm run test:email-templates",
    "test:ws-protocol": "node --import tsx --test tests/wsProtocol.test.ts",
    "test:auth-client": "node --import tsx --test tests/authClient.test.ts",
    "test:release": "node scripts/phase8/build-release-archive.mjs && node scripts/phase8/verify-release-archive.mjs artifacts/phase8/blckforest-release.zip",
    "phase8:verify": "node scripts/phase8/verify.mjs --mode=static",
    "phase8:verify:integration": "node scripts/phase8/verify.mjs --mode=integration",
    "phase8:verify:full": "node scripts/phase8/verify.mjs --mode=full",
    "phase8:redis": "node scripts/phase8/redis-failover.mjs",
    "phase8:database": "bash scripts/phase8/database-matrix.sh",
    "phase8:load:http": "node scripts/phase8/http-load.mjs",
    "phase8:load:ws": "node scripts/phase8/ws-soak.mjs",
    "e2e:install": "npm --prefix e2e install && npm --prefix e2e run install:browsers",
    "e2e:test": "npm --prefix e2e test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "test:enterprise-ui-admin": "node --import tsx --test tests/enterprisePhase67.test.ts",
    "test:admin": "node --import tsx --test tests/admin.integration.test.ts",
    "phase67:verify:source": "node scripts/phase67/verify-source.mjs .",
    "verify:login-fixes": "node scripts/auth/verify-fixes.mjs .",
    "local:bootstrap": "npm run db:generate && npm run db:deploy && npm run db:seed && npm run auth:doctor",
    "reconciliation:reset-local": "node --env-file-if-exists=.env --import tsx scripts/reconciliation/reset-local.ts",
    "local:repair": "npm run db:seed && npm run reconciliation:reset-local && npm run auth:doctor",
    "hardening:verify:source": "node scripts/hardening/verify-source.mjs .",
    "hardening:verify:typescript": "node scripts/hardening/verify-typescript.mjs .",
    "hardening:verify:static": "npm run hardening:verify:source && npm run quality:verify:source && npm run verify:login-fixes && npm run phase67:verify:source && npm run patch19:verify:source && npm run hardening:verify:typescript && npm run patch-payment-email:verify && npm run test:release && npm run feature-admin-balance:verify",
    "production:check": "NODE_ENV=production node --env-file-if-exists=.env.production --env-file-if-exists=.env scripts/production/preflight.mjs",
    "start:production": "npm run build && npm run start",
    "patch19:verify:source": "node scripts/patch19/verify-source.mjs .",
    "email:preview": "node --env-file-if-exists=.env --import tsx scripts/email/preview.ts",
    "patch-payment-email:verify": "node scripts/payment-email/verify-source.mjs .",
    "test:payment-methods": "node --import tsx --test tests/paymentMethodDetails.test.ts",
    "test:email-templates": "node --import tsx --test tests/emailTemplates.test.ts",
    "quality:verify:source": "node scripts/quality/verify-source.mjs .",
    "test:admin-balance": "node --import tsx --test tests/adminBalance.integration.test.ts",
    "feature-admin-balance:verify": "node scripts/admin-balance/verify-source.mjs ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@prisma/client": "^6.2.1",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^3.0.3",
    "lightweight-charts": "^5.0.3",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.5",
    "prisma": "^6.2.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.1.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
